# Supabase (públicas, usables en browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SOLO SERVER — jamás exponer con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Dominios permitidos para login, separados por coma. Vacío = todos.
# Ej: calidda.com.pe,contratista.com
AUTH_ALLOWED_DOMAINS=

# Opcional: protege /api/cron/heartbeat con Bearer
# CRON_SECRET=

# Opcional: SMTP para enviarCorreo (nodemailer)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Soluciones Hogar <no-reply@tudominio.com>"
