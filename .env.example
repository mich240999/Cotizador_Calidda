# Supabase (públicas, usables en browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SOLO SERVER — jamás exponer con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Dominios permitidos para login, separados por coma. Vacío = todos.
# Ej: calidda.com.pe,contratista.com
AUTH_ALLOWED_DOMAINS=

# Opcional: protege /api/cron/heartbeat con Bearer
# CRON_SECRET=

# SendGrid (alternativa sin DNS: verifica un remitente en Sender Authentication)
# SENDGRID_API_KEY=
# SENDGRID_FROM="Ambientes Cáliddos <correo-verificado@ejemplo.com>"
# Opcional: destino de avisos administrativos de Ventas
# SENDGRID_ADMIN_EMAIL=

# Resend (requiere dominio verificado; envía por HTTPS sin puertos SMTP)
# Crea la API key en https://resend.com/api-keys.
# RESEND_API_KEY=
# RESEND_FROM="Ambientes Cáliddos <notificaciones@calidda.com.pe>"
# Opcional: destino de avisos administrativos de Ventas
# RESEND_ADMIN_EMAIL=

# Opcional: fuerza el proveedor. Auto = SendGrid, luego Resend, luego SMTP.
# MAIL_PROVIDER=sendgrid

# Respaldo SMTP (solo local o Render pago; Render Free bloquea 25/465/587)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Soluciones Hogar <no-reply@tudominio.com>"
